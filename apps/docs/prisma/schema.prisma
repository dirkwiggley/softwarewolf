datasource db {
  provider = "mysql"
}

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

// 1. Define strict clearance levels
enum Role {
  ADMIN
  MANAGER
  USER
}

// 2. User Table tracking permissions
model User {
  id          String     @id @default(uuid())
  username    String     @unique
  displayName String
  email       String     @unique
  password    String     @default("")
  role        Role       @default(USER)
  createdAt   DateTime   @default(now())
  activities  Activity[]
}

// 3. Activity Table linked to users
model Activity {
  id        String   @id @default(uuid())
  title     String
  createdAt DateTime @default(now())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// 4. WidgetControl Table for UI text blocks
model WidgetControl {
  id          String   @id @default(uuid())
  controlKey  String   @unique
  heading     String
  bodyText    String   @db.Text
  updatedAt   DateTime @updatedAt
}
