{
  "name": "softwarewolf-home",
  "private": true,
"scripts": {
  "build": "turbo run build",
  "dev": "turbo run dev",
  "start": "turbo run start",
  "lint": "turbo run lint",
  "format": "prettier --write \"**/*.{ts,tsx,md}\"",
  "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "prettier": "^3.7.4",
    "turbo": "^2.10.11",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=18"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "12.0.2"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "allowScripts": {
    "esbuild@0.28.2": true,
    "prisma@7.9.1": true,
    "@prisma/engines@7.9.1": true
  }
}
